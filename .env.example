# =============================================================================
# Environment Variables Template
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# =============================================================================

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/releasehub
MONGODB_DB=releasehub

# Authentication & Cryptography Secrets
SESSION_SECRET=replace-with-a-secure-32-char-minimum-secret
ENCRYPTION_KEY=replace-with-exact-32-byte-key!!

