                    "label": "Talent Matching",
                    "icon": "Zap",
                    "path": "/plugins/cm-talent-matching",
                    "children": [
                        {
                            "label": "Match by Role",
                            "icon": "Briefcase",
                            "path": "/plugins/cm-talent-matching"
                        },
                        {
                            "label": "Match by Project",
                            "icon": "FolderOpen",
                            "path": "/plugins/cm-talent-matching/project"
                        },
                        {
                            "label": "Readiness Scores",
                            "icon": "Gauge",
                            "path": "/plugins/cm-talent-matching/readiness"
                        }
                    ]
                }
            ]
        }
    ],
    "widgets": [
        {
