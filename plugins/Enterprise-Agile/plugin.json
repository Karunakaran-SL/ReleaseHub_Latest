        }
    ],
    "features": [
        {
            "key": "strategy_manage",
            "label": "Strategy Management",
            "description": "Manage Themes, Epics, Value Streams."
        },
        {
            "key": "execution_manage",
            "label": "Execution Management",
            "description": "Manage ARTs, Capabilities, Features, Stories."
        },
        {
            "key": "intelligence_manage",
            "label": "Intelligence Management",
            "description": "Manage DORA, Risks, Skills, Financials."
        }
    ],
    "roles": [
        {
            "name": "portfolio_manager",
            "label": "Portfolio Manager",
            "description": "Full access to Strategy and Financials.",
