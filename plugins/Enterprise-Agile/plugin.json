                "strategy_manage": [
                    "view",
                    "create",
                    "edit",
                    "delete"
                ],
                "dashboard": [
                    "view"
                ]
            }
        },
        {
            "name": "product_manager",
            "label": "Product Manager",
            "description": "Full access to Features and ART execution.",
            "permissions": {
                "execution_manage": [
                    "view",
                    "create",
                    "edit",
                    "delete"
                ],
                "dashboard": [
                    "view"
                ]
            }
        },
        {
            "name": "agile_developer",
            "label": "Scrum Team / Developer",
            "description": "Access to Stories, Tasks, Boards.",
            "permissions": {
                "execution_manage": [
                    "view",
                    "edit"
                ],
                "dashboard": [
                    "view"
                ]
            }
        }
    ],
