                "marketplace_admin": [
                    "view",
                    "edit",
                    "delete"
                ]
            }
        },
        {
            "name": "capability_maintainer",
            "label": "Capability Maintainer",
            "description": "Can publish and edit owned capabilities.",
            "permissions": {
                "marketplace_admin": [
                    "view",
                    "edit"
                ]
            }
        },
        {
            "name": "developer",
            "label": "Developer",
            "description": "Can view and consume capabilities in the SDK generator.",
            "permissions": {
                "marketplace_admin": [
                    "view"
                ]
            }
        }
    ],
    "dependencies": {}
