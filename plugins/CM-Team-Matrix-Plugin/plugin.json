                {
                    "label": "Team Matrix",
                    "icon": "Grid3x3",
                    "path": "/plugins/cm-team-matrix",
                    "children": [
                        {
                            "label": "Matrix View",
                            "icon": "Grid3x3",
                            "path": "/plugins/cm-team-matrix"
                        },
                        {
                            "label": "Team Comparison",
                            "icon": "GitCompare",
                            "path": "/plugins/cm-team-matrix/compare"
                        },
                        {
                            "label": "Export",
                            "icon": "Download",
                            "path": "/plugins/cm-team-matrix/export"
                        }
                    ]
                }
            ]
        }
    ],
    "widgets": [
        {
            "id": "cm-team-readiness",
            "title": "Team Readiness",
