{
    "id": "cm-team-matrix",
    "version": "1.0.0",
    "name": "CM: Team Competency Matrix",
    "description": "Display team skill matrices as interactive grids. Calculate team readiness scores and export matrices for reporting.",
    "publisher": "ReleaseHub Internal",
    "navigation": [
        {
            "type": "main-menu",
            "label": "Competence Management",
            "icon": "GraduationCap",
            "path": "/plugins/cm-team-matrix",
