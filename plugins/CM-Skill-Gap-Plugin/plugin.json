                {
                    "label": "Skill Gap Analysis",
                    "icon": "TrendingDown",
                    "path": "/plugins/cm-skill-gap",
                    "children": [
                        {
                            "label": "Individual Gap",
                            "icon": "User",
                            "path": "/plugins/cm-skill-gap"
                        },
                        {
                            "label": "Team Gap",
                            "icon": "Users",
                            "path": "/plugins/cm-skill-gap/team"
                        },
                        {
                            "label": "Organisation Gap",
                            "icon": "Building",
                            "path": "/plugins/cm-skill-gap/organisation"
                        }
                    ]
                }
            ]
        }
    ],
    "widgets": [
        {
            "id": "cm-top-gaps",
            "title": "Top Skill Gaps",
